{
  "name": "taskly-backend",
  "version": "2.0.0",
  "description": "Taskly is a task management API built as a modular monolith.",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "src/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nodemon src/main.js",
    "start": "node src/main.js",
    "seed": "node src/scripts/seed.js",
    "secret-key": "openssl rand -base64 32",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/**/*.test.js\"",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage \"test/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write \"{src,test}/**/*.js\"",
    "format:check": "prettier --check \"{src,test}/**/*.js\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0",
    "multer": "^2.4.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10"
  }
}
